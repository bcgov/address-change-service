# Optional local configuration. Copy to .env and customize.
# SERVER_PORT is also the host port used by compose.yml.
# Existing shell environment variables take precedence.
SERVER_PORT=8080
ENABLE_FLYWAY=true

# Local PostgreSQL container. These credentials are for local development only.
LOCAL_DATABASE_PORT=15432
LOCAL_DATABASE_NAME=address_change
LOCAL_DATABASE_SCHEMA=address_change
LOCAL_POSTGRES_ADMIN_USERNAME=postgres
LOCAL_POSTGRES_ADMIN_PASSWORD=local-postgres-admin
LOCAL_FLYWAY_USERNAME=address_change_migration
LOCAL_FLYWAY_PASSWORD=local-address-change-migration
LOCAL_DATABASE_RUNTIME_USERNAME=address_change_runtime
LOCAL_DATABASE_RUNTIME_PASSWORD=local-address-change-runtime

# Docker supplies Java and the Maven Wrapper supplies the pinned Maven version.
